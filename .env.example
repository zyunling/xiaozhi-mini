# 小智 MCP 连接 Token
# 从小智后台获取，复制本文件为 .env 后填入真实 token

# 单 token（向后兼容）：config.yaml 不配 tokens 时使用此项
XIAOZHI_TOKEN=REPLACE_WITH_YOUR_TOKEN

# 多 token（新功能）：在 config.yaml 中配置 xiaozhi.tokens 数组时使用
# 取消下面注释并填入多个小智 token，即可同时连接多个接入
# XIAOZHI_TOKEN_1=your_first_xiaozhi_token
# XIAOZHI_TOKEN_2=your_second_xiaozhi_token

# Home Assistant MCP 长期访问令牌
# config.yaml 中 ha.url 用 ${HA_TOKEN} 引用，避免明文写入配置文件
HA_TOKEN=REPLACE_WITH_YOUR_HA_TOKEN

# 可选：Tavily 搜索 API Key
# config.yaml 中用 ${TAVILY_API_KEY} 引用
# TAVILY_API_KEY=your_tavily_key
