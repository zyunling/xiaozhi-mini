# ============================================================
# xiaozhi-mini 环境变量配置
# 复制本文件为 .env，填入你的真实值
# 改完 .env 后 docker compose restart 生效
# ============================================================

# ── 小智 MCP 连接 ──────────────────────────────────────────
# 从小智官方后台复制完整的 wss 链接，直接粘贴进来
# 单个接入：
XIAOZHI_URL=wss://api.xiaozhi.me/mcp/?token=REPLACE_WITH_YOUR_TOKEN

# 多个接入（可选，取消注释后在 config.yaml 中启用 xiaozhi.urls）：
# XIAOZHI_URL_1=wss://api.xiaozhi.me/mcp/?token=your_first_token
# XIAOZHI_URL_2=wss://api.xiaozhi.me/mcp/?token=your_second_token

# ── Home Assistant MCP ─────────────────────────────────────
# 填入你的 HA 完整 MCP 地址（含长期访问令牌）
HA_MCP_URL=http://192.168.1.100:9583/REPLACE_WITH_YOUR_HA_TOKEN

# ── Tavily 搜索 ────────────────────────────────────────────
# 从 https://tavily.com 获取 API Key
TAVILY_API_KEY=REPLACE_WITH_YOUR_TAVILY_KEY

# ── Navidrome 音乐服务（wt512 固件自定义音源）───────────────
# Navidrome 服务器地址，用局域网 IP（不要用 https 域名，ESP32 需要局域网直连）
NAVIDROME_URL=http://192.168.1.100:4533
# Navidrome 登录用户名和密码
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=your_navidrome_password
# 音源桥接服务监听端口（默认 8650）
MUSIC_BRIDGE_PORT=8650
# 音源桥接服务绑定IP（默认 0.0.0.0 监听所有网卡）
# MUSIC_BRIDGE_BIND_IP=0.0.0.0
# 对外公布的 IP（用于拼接stream URL，默认自动取第一个局域网IP）
# 多网卡/反向代理场景才需要手动填
# MUSIC_BRIDGE_PUB_IP=192.168.1.200
# 如果用反向代理+域名暴露到公网，填完整URL（优先级高于 PUB_IP）
# MUSIC_BRIDGE_PUB_URL=https://music-bridge.example.com:17668
# MCP 服务端口（默认 8660，供 xiaozhi-mini 接入）
# NAVIDROME_MCP_PORT=8660
