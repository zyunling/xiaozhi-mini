# ============================================================
# xiaozhi-mini 环境变量配置
# 复制本文件为 .env，填入你的真实值
# 改完 .env 后 docker compose restart 生效
# ============================================================

# ── 小智 MCP 连接 ──────────────────────────────────────────
# 从小智官方后台复制完整的 wss 链接，直接粘贴进来
# 单个接入：
XIAOZHI_URL=wss://api.xiaozhi.me/mcp/?token=REPLACE_WITH_YOUR_TOKEN

# 多个接入（可选，取消注释后在 config.yaml 中启用 xiaozhi.urls）：
# XIAOZHI_URL_1=wss://api.xiaozhi.me/mcp/?token=your_first_token
# XIAOZHI_URL_2=wss://api.xiaozhi.me/mcp/?token=your_second_token

# ── Home Assistant MCP ─────────────────────────────────────
# 填入你的 HA 完整 MCP 地址（含长期访问令牌）
HA_MCP_URL=http://192.168.1.100:9583/REPLACE_WITH_YOUR_HA_TOKEN

# ── Tavily 搜索 ────────────────────────────────────────────
# 从 https://tavily.com 获取 API Key
TAVILY_API_KEY=REPLACE_WITH_YOUR_TAVILY_KEY
